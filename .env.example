# Local development works with these empty. Never commit .env.local.
DATABASE_URL=
SESSION_SECRET=
BLUE_ACCESS_CODE=
RED_ACCESS_CODE=
APP_ORIGIN=
LOO_TIMEZONE=America/Toronto

# Optional online map services. Defaults work without an API key.
# Search must expose a Nominatim-compatible /search API.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
# Browser-visible tile URL; do not put private credentials here.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# For local `npm run start` preview ONLY. Vercel never permits file-based demo mode.
LOO_LOCAL_DEMO=false

# Optional deployment credentials, only needed by deployment tooling, not the app.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Web Push: generate once; keep the private key server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
